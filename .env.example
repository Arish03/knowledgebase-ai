# Ollama VM connection (REQUIRED — never hardcode IPs)
OLLAMA_BASE_URL=http://<vm-private-ip>:11434

# Model names
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Paths
CHROMA_DB_PATH=./chroma_db
COMPANY_DOCS_PATH=./company_docs

# API server
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (Phase 2 — tool-calling, optional)
# Use a READ-ONLY database role — never an admin account
DB_HOST=<db-host>
DB_PORT=5432
DB_NAME=<db-name>
DB_USER=<read-only-user>
DB_PASSWORD=<password>
